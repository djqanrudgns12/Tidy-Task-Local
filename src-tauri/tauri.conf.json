{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tidy Task",
  "version": "../package.json",
  "identifier": "com.tidy.task",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tidy Task",
        "width": 350,
        "height": 500,
        "minWidth": 250,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false 
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "**"
          ]
        }
      },
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBODRCNkRFMUVEMkY0NQpSV1JGTCszaGJVdW9EWVQzMVBhekFWQTc1QllSUDNlZzc1OXI3Q3p6TjVCQUpqVWJQenBZdk1Vbwo=",
      "endpoints": [
        "https://github.com/djqanrudgns12/Tidy-Task-Local/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/data-preserving-uninstall.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
