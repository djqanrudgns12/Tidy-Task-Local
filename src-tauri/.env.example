# 다른 컴퓨터에서 빌드할 때: 이 파일을 복사해 .env로 이름을 바꾸고 키를 넣어 주세요.
# 키가 비어 있으면 개발 앱만 샘플 모드로 실행되며, 배포용 빌드는 중단됩니다.
# 키는 빌드 때 실행 파일에 포함됩니다. 이용자는 별도로 키나 .env를 설정하지 않습니다.
NEIS_API_KEY=

# PostHog 공개 Project token만 사용합니다. 개인 API 키/secret key는 넣지 않습니다.
POSTHOG_PROJECT_TOKEN=
# EU 프로젝트라면 https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# 개발 빌드는 기본 전송 금지. 별도 테스트 프로젝트에서만 1로 설정합니다.
POSTHOG_DEV_ENABLED=0
