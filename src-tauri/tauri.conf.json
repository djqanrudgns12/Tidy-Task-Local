{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tidy Task",
  "version": "../package.json",
  "identifier": "com.tidy.task",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tidy Task",
        "width": 350,
        "height": 500,
        "minWidth": 250,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false 
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "**"
          ]
        }
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}